#!/usr/bin/env python3
"""Search the Obsidian vault by meaning, with a keyword pass folded in.

Semantic layer is vendored from obsidian-second-brain (MIT, see vendor/).
This wrapper adds:
  - vault-root resolution, so it runs from any cwd (lxplus included)
  - a ripgrep pass merged into the ranking, because pure-semantic ranking
    tails off on short factual queries ("which sites get re-admitted")
  - snippet output, so callers get context without opening every file

Usage:
    vault-search "why did the limit come out wrong"
    vault-search --limit 5 --no-archive "crab memory"
    vault-search --build          # refresh the index after writing notes
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
sys.path.insert(0, str(HERE / "vendor"))


def vault_root() -> Path:
    """Vault root: $OBSIDIAN_VAULT_PATH, else two levels up from this script."""
    env = os.environ.get("OBSIDIAN_VAULT_PATH")
    if env:
        return Path(env).expanduser().resolve()
    return Path(__file__).resolve().parents[2]


def keyword_hits(vault: Path, query: str, limit: int) -> tuple[dict[str, float], str]:
    """Rank files by length-normalised match count for the query's content words.

    Returns ({relpath: score}, error_message). Prefers ripgrep but falls
    back to POSIX grep: `rg` is often a shell function/alias rather than a real
    binary (and is absent on lxplus), which shutil.which cannot see -- relying
    on it alone silently disabled this whole arm.
    """
    tool = shutil.which("rg") or shutil.which("grep")
    if not tool:
        return {}, "no rg/grep on PATH"
    use_rg = Path(tool).name == "rg"
    # Drop stopwords and short tokens; what's left are the terms worth matching.
    stop = {
        "the", "a", "an", "and", "or", "but", "if", "of", "to", "in", "on", "for",
        "with", "how", "why", "what", "when", "which", "that", "this", "is", "are",
        "was", "were", "do", "does", "did", "i", "my", "me", "it", "its", "from",
        "at", "by", "as", "be", "been", "can", "could", "would", "should", "get",
        "got", "out", "up", "so", "not", "no", "yes", "we", "you",
    }
    terms = [t for t in re.findall(r"[A-Za-z0-9_+-]{3,}", query.lower()) if t not in stop]
    if not terms:
        return {}, ""
    pattern = "|".join(re.escape(t) for t in terms)
    # Honour the same skip set as the semantic indexer, or the two arms search
    # different universes (venvs, node_modules and .git would leak into results).
    try:
        from vault_ops import _SKIP_DIRS as skip
    except ImportError:
        skip = {".git", ".obsidian", "node_modules", "__pycache__"}
    if use_rg:
        cmd = [tool, "-i", "--count-matches", "--glob", "*.md"]
        cmd += [f"--glob=!{d}/" for d in sorted(skip)]
        cmd += ["-e", pattern, "."]
    else:
        # POSIX grep: -c counts matching *lines*, close enough for rank order.
        cmd = [tool, "-rIic", "--include=*.md"]
        cmd += [f"--exclude-dir={d}" for d in sorted(skip)]
        cmd += ["-E", "-e", pattern, "."]
    try:
        proc = subprocess.run(cmd, cwd=vault, capture_output=True, text=True, timeout=60)
    except (subprocess.SubprocessError, OSError) as exc:
        return {}, f"keyword search failed: {exc}"
    hits: dict[str, float] = {}
    for line in proc.stdout.splitlines():
        path, _, count = line.rpartition(":")
        # grep -c emits a 0 line for every non-matching file; drop those.
        if not path or not count.isdigit() or int(count) == 0:
            continue
        rel = path.lstrip("./")
        n = int(count)
        # Normalise by document length. Raw counts rank a long document that
        # says "list" 19 times above the note whose *title* is the query --
        # which is how "systematics master list" missed
        # 2026-07-24-systematics-master-list.md entirely.
        try:
            kb = max(1.0, (vault / rel).stat().st_size / 1024.0)
        except OSError:
            kb = 1.0
        score = n / (kb ** 0.5)
        # A term appearing in the filename is a much stronger signal than the
        # same term buried in prose: filenames are chosen, not incidental.
        stem = Path(rel).stem.lower().replace("-", " ").replace("_", " ")
        matched = sum(1 for t in terms if t in stem)
        if matched:
            score *= 1.0 + 2.0 * (matched / len(terms))
        hits[rel] = score
    return dict(sorted(hits.items(), key=lambda kv: -kv[1])[: limit * 4]), ""


def snippet(vault: Path, rel: str, query: str, width: int = 200) -> str:
    """First line mentioning a query term, else the first prose line."""
    try:
        text = (vault / rel).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""
    terms = [t for t in re.findall(r"[A-Za-z0-9_+-]{4,}", query.lower())]
    lines = [ln.strip() for ln in text.splitlines()]
    prose = [
        ln for ln in lines
        if ln and not ln.startswith(("---", "#", "|", "```", "tags:", "status:", "date:", "source:"))
        # Marp decks open with a CSS block; those lines are not prose.
        and not re.match(r"^[.#@]?[\w-]+\s*\{|^\}|^\s*[\w-]+:\s*[^ ]+;\s*$", ln)
    ]
    for ln in prose:
        low = ln.lower()
        if any(t in low for t in terms):
            return ln[:width]
    return prose[0][:width] if prose else ""


def search_multi(vault: Path, query: str, limit: int, tiers: list[str] | None,
                 no_archive: bool = False):
    """Search the multi-source index (notes + papers + code).

    Ranking = RRF(semantic, keyword) x tier weight x recency. Tier weight is
    what makes notes outrank an equally-relevant code file; recency is a gentle
    tiebreak so the newest note wins among equals.

    Returns (results, error). error non-empty means fall back to notes-only.
    """
    try:
        import build_index as bi
        import semantic_search as ss
        import sources
    except ImportError as exc:
        return [], f"multi-source modules unavailable: {exc}"

    index_path = vault / bi.INDEX_FILE
    if not index_path.exists():
        return [], f"no multi-source index at {index_path.name} (build: scripts/rag/build_index.py)"
    try:
        idx = json.loads(index_path.read_text())
    except Exception as exc:
        return [], f"multi-source index unreadable: {exc}"
    docs = idx.get("docs") or {}
    if not docs:
        return [], "multi-source index is empty"

    try:
        qvec = ss.embed(query, model=idx.get("model"))
    except Exception as exc:
        return [], f"embedding backend unavailable: {exc}"

    now = time.time()
    scored = []
    for ident, e in docs.items():
        if tiers and e.get("tier") not in tiers:
            continue
        vecs = e.get("vecs") or []
        if not vecs:
            continue
        # Best-matching chunk represents the document: one relevant section
        # should surface a long paper, not be averaged away by the rest.
        sim = max((ss.cosine(qvec, v) for v in vecs), default=0.0)
        scored.append((sim, ident, e))
    if not scored:
        return [], "no documents in the requested tiers"
    scored.sort(key=lambda t: -t[0])
    sem_rank = {ident: i for i, (_, ident, _) in enumerate(scored)}
    sem_sim = {ident: s for s, ident, _ in scored}

    # Keyword arm over the vault, fused with the semantic order. Without this
    # the ranking is pure cosine, which tails off on short factual queries
    # ("blacklist") that name a term the note uses but the query barely
    # contextualises -- the exact case RRF was added to cover.
    kw, _ = keyword_hits(vault, query, limit)
    lex_rank = {rel: i for i, rel in enumerate(kw)}

    K = 60
    out = []
    # Union of both rankings, so a keyword-only hit can still surface.
    idents = set(list(sem_rank)[: max(limit * 5, 40)]) | (set(lex_rank) & set(docs))
    for ident in idents:
        e = docs[ident]
        tier = e.get("tier", "notes")
        if tiers and tier not in tiers:
            continue
        rrf = 0.0
        if ident in sem_rank:
            rrf += 1.0 / (K + sem_rank[ident])
        if ident in lex_rank:
            rrf += 1.0 / (K + lex_rank[ident])
        # Superseded notes are demoted (x0.25), never hidden: "what did we think
        # in June" is a legitimate question, and the note is tagged in output so
        # a stale conclusion can't be mistaken for a current one.
        w = sources.TIER_WEIGHT.get(tier, 0.5)
        rec = sources.freshness(e, now)
        sim = sem_sim.get(ident, 0.0)
        out.append({
            "id": ident, "tier": tier, "path": e.get("path", ident),
            "sim": sim, "score": rrf * w * rec,
            "status": e.get("status", ""),
            "superseded_by": e.get("superseded_by", ""),
        })
    # Filter before slicing, or --no-archive silently returns fewer than `limit`.
    if no_archive:
        out = [r for r in out if not r["id"].startswith("Archive/")]
    # With a single tier requested, tier weight is a constant and only muddies
    # the order: rank by raw similarity so the printed score matches the sort.
    if tiers and len(tiers) == 1:
        out.sort(key=lambda r: -r["sim"])
    else:
        out.sort(key=lambda r: -r["score"])
    return out[:limit], ""


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(
        prog="vault-search",
        description="Semantic + keyword search over notes, papers and lxplus code.",
    )
    ap.add_argument("query", nargs="*", help="Natural-language query")
    ap.add_argument("--limit", type=int, default=8, help="Max results (default 8)")
    ap.add_argument("--build", action="store_true", help="Rebuild the index, then exit")
    ap.add_argument("--no-archive", action="store_true", help="Hide Archive/ hits")
    ap.add_argument("--paths-only", action="store_true", help="Print paths, no scores/snippets")
    ap.add_argument(
        "--tier", action="append", choices=["notes", "papers", "code"],
        help="Restrict to a tier (repeatable). Default: all, notes ranked first.",
    )
    ap.add_argument(
        "--notes-only", action="store_true",
        help="Search only vault notes (skips the multi-source index)",
    )
    args = ap.parse_args(argv)

    vault = vault_root()
    if not vault.is_dir():
        print(f"vault-search: no vault at {vault}", file=sys.stderr)
        return 2

    try:
        import semantic_search as ss
    except ImportError as exc:
        print(f"vault-search: cannot load vendored search core: {exc}", file=sys.stderr)
        return 2

    if args.build:
        try:
            ss.build_index(vault)
        except Exception as exc:
            print(f"vault-search: index build failed: {exc}", file=sys.stderr)
            print("Is Ollama running?  ollama serve   /   ollama pull bge-m3", file=sys.stderr)
            return 1
        return 0

    query = " ".join(args.query).strip()
    if not query:
        ap.error("a query is required (or use --build)")

    # Multi-source path (notes + papers + code) unless notes-only is forced.
    # Falls through to the notes-only index if it is unavailable, so this
    # never becomes a hard dependency.
    if not args.notes_only:
        results, err = search_multi(vault, query, args.limit, args.tier, args.no_archive)
        if not err:
            if results:
                for r in results:
                    ident = r["id"]
                    if args.paths_only:
                        print(ident)
                        continue
                    label = {"papers": " [PDF]", "code": " [CODE]"}.get(r["tier"], "")
                    if ident.startswith("Archive/"):
                        label += " [ARCHIVED]"
                    # Loud, because the whole point is that a stale conclusion
                    # must never read as a current one.
                    if r.get("status") == "superseded":
                        sb = r.get("superseded_by") or ""
                        label += f" [SUPERSEDED{' → ' + sb if sb else ''}]"
                    print(f"{r['sim']:.3f}  {ident}{label}")
                    snip = snippet(vault, ident, query) if r["tier"] == "notes" else ""
                    if snip:
                        print(f"        {snip}")
                return 0
        elif args.tier:
            # An explicit --tier request cannot be served by the notes-only
            # fallback, so say why instead of silently changing the scope.
            print(f"vault-search: {err}", file=sys.stderr)
            return 1
        else:
            print(f"[multi-source unavailable: {err}]", file=sys.stderr)

    # Ripgrep pass, shaped as the [{path,title,score}] the fuser expects.
    # Already rank-ordered by match count.
    kw, kw_err = keyword_hits(vault, query, args.limit)
    if kw_err:
        print(f"[keyword arm unavailable: {kw_err}]", file=sys.stderr)
    lexical = [{"path": rel, "title": Path(rel).stem, "score": float(n)} for rel, n in kw.items()]

    # Fuse with the vendored Reciprocal Rank Fusion: it combines the two rank
    # orders without needing cosine values and match counts to be comparable.
    # Falls back to keyword-only if Ollama or the index is unavailable, so a
    # missing index still returns something useful instead of erroring out.
    semantic_failed = ""
    over = max(args.limit * 3, 20)
    try:
        index = ss.load_index(vault)
        results = ss.hybrid_search(query, index, lexical, limit=over)
    except Exception as exc:
        semantic_failed = str(exc)
        results = [dict(r, score=1.0 / (60 + i)) for i, r in enumerate(lexical)]

    ranked = [(r["path"], r["score"]) for r in results]
    if args.no_archive:
        ranked = [(r, s) for r, s in ranked if not r.startswith("Archive/")]
    ranked = ranked[: args.limit]

    if not ranked:
        print("No matches.", file=sys.stderr)
        if semantic_failed:
            print(f"(semantic layer unavailable: {semantic_failed})", file=sys.stderr)
        return 1

    if semantic_failed:
        print(f"[keyword-only: {semantic_failed}]", file=sys.stderr)

    for rel, score in ranked:
        if args.paths_only:
            print(rel)
            continue
        tag = " [ARCHIVED]" if rel.startswith("Archive/") else ""
        print(f"{score:.4f}  {rel}{tag}")
        snip = snippet(vault, rel, query)
        if snip:
            print(f"        {snip}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
