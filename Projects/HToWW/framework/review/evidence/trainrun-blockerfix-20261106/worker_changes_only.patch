+                eio._is_eos = lambda p: True
+                eio.read_bytes = lambda p, prefer_server=False: good.read_bytes()
+                self.assertEqual(eio.read_parquet(str(bad))['x'].to_pylist(), [1, 2])
+            finally:
+                eio._is_eos, eio.read_bytes = saved
